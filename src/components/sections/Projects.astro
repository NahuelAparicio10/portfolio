---
import ShowcaseCard from "../ui/card/ShowcaseCard.astro";
import { getProjects } from "../../data/projects";
import { asset, DEFAULT_LOCALE, type Locale } from "../../lib/href";

interface Props {
  title?: string;
  locale?: Locale;
}

const { title, locale = DEFAULT_LOCALE } = Astro.props as Props;
const projects = getProjects(locale);
---

<section class="w-full py-10">
  <div class="mx-auto max-w-6xl px-4">
    {title && (
      <h2 class="text-3xl md:text-4xl font-semibold text-center mb-8 text-foreground">{title}</h2>
    )}

    <!-- Same card and grid as the games section. Every project leads off-site
         (GitHub or a video), so the whole card is the link and opens a new tab. -->
    <div class="showcase-grid" data-showcase-grid data-reveal>
      {projects.map((p) => (
        <div class="showcase-cell" data-reveal-child>
          <ShowcaseCard
            href={p.ctaLink}
            external
            title={p.title}
            description={p.description}
            image={p.image}
            genre={p.genre}
            dimension={p.dimension}
            facts={[String(p.year), p.engine, p.team, p.duration].filter((v): v is string => Boolean(v))}
            tags={p.techStack.map((tech) => ({ label: tech }))}
            ctaText={p.ctaText}
            videoPreview={p.videoPreview ? asset(p.videoPreview) : undefined}
          />
        </div>
      ))}
    </div>
  </div>
</section>
