---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../../../i18n';
import { DEFAULT_LOCALE, href, type Locale } from '../../../lib/href';

export interface NavItem { id: string; title: string; image?: ImageMetadata }
interface Props { prev?: NavItem | null; next?: NavItem | null; locale?: Locale }
const { prev = null, next = null, locale = DEFAULT_LOCALE } = Astro.props as Props;

const t = useTranslations(locale);
---

{(prev || next) && (
  <nav class="sw-post-nav mt-8 pt-4 border-t border-[color:var(--color-border-light)]">
    <div class="flex flex-col md:flex-row md:justify-between gap-3 md:gap-4">
      {prev ? (
        <a href={href(`/blog/${prev.id}/`, locale)} class="sw-nav-btn no-underline flex-1">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          {prev.image && <Image class="post-nav-thumb" src={prev.image} alt="" width={160} height={90} />}
          <div class="sw-nav-text">
            <span class="sw-nav-label">{t.blog.previous}</span>
            <span class="truncate">{prev.title}</span>
          </div>
        </a>
      ) : <span class="flex-1" />}

      {next ? (
        <a href={href(`/blog/${next.id}/`, locale)} class="sw-nav-btn no-underline justify-end flex-1">
          <div class="sw-nav-text text-right">
            <span class="sw-nav-label">{t.blog.next}</span>
            <span class="truncate">{next.title}</span>
          </div>
          {next.image && <Image class="post-nav-thumb" src={next.image} alt="" width={160} height={90} />}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="m8.59 16.59 1.41 1.41 6-6-6-6-1.41 1.41L13.17 12z"/></svg>
        </a>
      ) : <span class="flex-1" />}
    </div>
  </nav>
)}

<style>
  .sw-post-nav :global(.post-nav-thumb) {
    flex: none;
    width: 5rem;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    border-radius: 6px;
  }

  /* Titles can be long; without this the text column refuses to shrink and
     the ellipsis never kicks in. */
  .sw-post-nav .sw-nav-text {
    min-width: 0;
  }
</style>
