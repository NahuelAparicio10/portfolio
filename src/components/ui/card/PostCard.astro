---
import { asset, DEFAULT_LOCALE, href, type Locale } from '../../../lib/href';
import { useTranslations } from '../../../i18n';
import { postYear, type Post } from '../../../lib/post';
import ShowcaseCard from './ShowcaseCard.astro';

interface Props { post: Post; locale?: Locale; featured?: boolean }
const { post, locale = DEFAULT_LOCALE, featured = false } = Astro.props as Props;
const data = post.data;
const t = useTranslations(locale);

// Tags that repeat something already on the card (engine, platform, 2D/3D badge) are noise.
const shownFacts = new Set([data.engine, data.dimension, ...(data.platforms ?? [])].filter(Boolean).map((v) => v!.toLowerCase()));
const tags = (data.tags ?? [])
  .filter((tag) => !shownFacts.has(tag.toLowerCase()))
  .map((tag) => ({ label: tag, href: href(`/blog/tag/${tag.replace(/\s+/g, '-').toLowerCase()}/`, locale) }));
---

<ShowcaseCard
  href={href(`/blog/${post.id}/`, locale)}
  title={data.title}
  description={data.description}
  image={data.heroImage}
  genre={data.genre}
  dimension={data.dimension}
  facts={[String(postYear(post)), data.engine, data.team, data.duration].filter((v): v is string => Boolean(v))}
  tags={tags}
  featured={featured}
  featuredLabel={t.showcase.featured}
  transitionId={post.id}
  videoPreview={data.videoPreview ? asset(data.videoPreview) : undefined}
/>
