---
/**
 * 2D / 3D marker. The two differ in colour *and* in icon (flat square vs
 * cube), so they stay distinguishable for colour-blind visitors too.
 */
interface Props {
  dimension: '2D' | '3D';
  class?: string;
}

const { dimension, class: className } = Astro.props as Props;
---

<span class:list={['dimension-badge', `dimension-badge--${dimension.toLowerCase()}`, className]}>
  {dimension === '3D' ? (
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7ZM3.5 7 12 11.5 20.5 7M12 11.5v10" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  )}
  {dimension}
</span>

<style>
  .dimension-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.04em;
    backdrop-filter: blur(4px);
  }

  .dimension-badge--3d {
    color: var(--accent-light);
    background: rgba(7, 11, 22, 0.8);
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    box-shadow: 0 0 12px rgba(var(--accent-rgb), 0.25);
  }

  /* Amber: the one warm hue on a blue site, so 2D reads at a glance. */
  .dimension-badge--2d {
    color: #fcd34d;
    background: rgba(7, 11, 22, 0.8);
    border: 1px solid rgba(245, 158, 11, 0.65);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.22);
  }
</style>
