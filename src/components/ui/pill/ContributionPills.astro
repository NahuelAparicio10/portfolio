---
/**
 * "What I built" pills inside a game post.
 *
 * Replaces a block of inline-styled JSX that was pasted into all fourteen
 * posts. The pills pop in one after another through the site's reveal system
 * (`data-reveal` / `data-reveal-child` in src/lib/motion.ts), so without
 * JavaScript or with reduced motion they are simply there.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props as Props;
---

<ul class="contrib-pills" data-reveal>
  {items.map((item) => (
    <li class="contrib-pill" data-reveal-child>{item}</li>
  ))}
</ul>

<style>
  .contrib-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1rem 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .contrib-pill {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent-light);
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.32);
    cursor: default;
    transition:
      transform var(--motion-fast) var(--motion-ease),
      color var(--motion-fast) var(--motion-ease),
      background-color var(--motion-fast) var(--motion-ease),
      box-shadow var(--motion-fast) var(--motion-ease);
  }

  /* A band of light that crosses the pill on hover. */
  .contrib-pill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.45) 50%, transparent 70%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  /* The reveal system sets opacity/transform on each child; a pop with a
     slight overshoot reads livelier than the default rise for small chips. */
  :global([data-reveal][data-motion-ready]) .contrib-pill {
    transform: translateY(0.6rem) scale(0.85);
    transition:
      opacity var(--motion-base) cubic-bezier(0.34, 1.56, 0.64, 1),
      transform var(--motion-base) cubic-bezier(0.34, 1.56, 0.64, 1),
      color var(--motion-fast) var(--motion-ease),
      background-color var(--motion-fast) var(--motion-ease),
      box-shadow var(--motion-fast) var(--motion-ease);
  }

  :global([data-reveal][data-motion-ready].is-revealed) .contrib-pill {
    transform: none;
  }

  /* The attribute selectors are there for weight: the reveal system's
     is-revealed rule sets transform: none on every child and would otherwise
     cancel the lift. */
  @media (hover: hover) {
    .contrib-pills[data-reveal] .contrib-pill[data-reveal-child]:hover {
      transform: translateY(-3px) scale(1.06);
      color: var(--primary-foreground);
      background: var(--accent);
      box-shadow: 0 8px 20px rgba(var(--accent-rgb), 0.4);
      transition-delay: 0ms;
    }

    .contrib-pill:hover::after {
      transform: translateX(120%);
      transition: transform 600ms var(--motion-ease);
    }
  }

  /* Touch: the press is the only feedback available. */
  .contrib-pill:active {
    transform: scale(0.96);
    background: rgba(var(--accent-rgb), 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .contrib-pill,
    .contrib-pill:active,
    .contrib-pills[data-reveal] .contrib-pill[data-reveal-child]:hover {
      transform: none;
    }

    .contrib-pill::after {
      display: none;
    }
  }
</style>
