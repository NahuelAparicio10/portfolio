---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import Projects from "../../components/sections/Projects.astro";
import ShowcaseHero from "../../components/sections/ShowcaseHero.astro";
import { useTranslations } from "../../i18n";

const t = useTranslations("es");
---

<html lang="es" data-theme="dark" class="dark">
  <head>
  <BaseHead title={t.projects.title} description={t.projects.metaDescription} />
  </head>
  <body>
    <Header />
    <main>
      <ShowcaseHero title={t.projects.heading} subtitle={t.projects.subtitle} />
      <Projects locale="es" />
    </main>
    <Footer />
  </body>
</html>
