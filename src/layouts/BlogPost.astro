---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import PostNav, { type NavItem } from '../components/ui/nav/PostNav.astro';
import YouTubeFacade from '../components/ui/video/YouTubeFacade.astro';
import DimensionBadge from '../components/ui/badge/DimensionBadge.astro';
import { useTranslations } from '../i18n';
import { getLocaleFromPath } from '../lib/href';
import type { Post } from '../lib/post';

type BlogData = Post['data'];
type Props = BlogData & {
  /** Post id. Names the view transition shared with the grid card. */
  id: string;
  showHeader?: boolean;
  prevPost?: NavItem | null;
  nextPost?: NavItem | null;
};

const {
  id,
  title,
  description,
  pubDate,
  heroImage,
  tags = [],
  youtubeID,
  youtubeTitle,
  genre,
  dimension,
  engine,
  role = [],
  team,
  duration,
  platforms = [],
  showHeader = true,
  prevPost = null,
  nextPost = null,
} = Astro.props as Props;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// Production facts only. Roles are rendered separately: they describe what
// Nahuel did, not what the project was, and mixing them made both harder to scan.
const facts = [
  { label: t.showcase.facts.year, value: String(pubDate.getUTCFullYear()) },
  { label: t.showcase.facts.engine, value: engine },
  { label: t.showcase.facts.team, value: team },
  { label: t.showcase.facts.duration, value: duration },
  { label: t.showcase.facts.platforms, value: platforms.join(' · ') },
].filter((fact) => Boolean(fact.value));
---

<html lang={locale} data-theme="dark" class="dark">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <meta property="og:type" content="article" />
    <meta property="article:author" content="Nahuel Aparicio" />

    {tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}
  </head>

  <body>
    <Header />
    <article>
      {showHeader && (
        <header class="detail-hero">
          <div class="detail-cover" style={`view-transition-name: cover-${id}`}>
            {heroImage && (
              <Image src={heroImage} alt="" width={1920} height={1080} loading="eager" fetchpriority="high" />
            )}
          </div>
          <div class="detail-hero-text">
            <h1 class="detail-title" style={`view-transition-name: title-${id}`}>{title}</h1>
            {(genre || dimension) && (
              <p class="detail-genre">
                {dimension && <DimensionBadge dimension={dimension} />}
                {genre}
              </p>
            )}
          </div>
        </header>
      )}

      <main class="detail-main">
        {(facts.length > 0 || role.length > 0) && (
          <section class="detail-sheet">
            {facts.length > 0 && (
              <dl class="detail-facts">
                {facts.map((fact) => (
                  <div class="detail-fact">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {role.length > 0 && (
              <div class="detail-roles">
                <span class="detail-roles-label">{t.showcase.facts.role}</span>
                <ul>
                  {role.map((r) => <li class="pill-tech">{r}</li>)}
                </ul>
              </div>
            )}
          </section>
        )}

        {youtubeID && (
          <div class="detail-video">
            <YouTubeFacade id={youtubeID} title={youtubeTitle ?? title} fallbackImage={heroImage} locale={locale} />
          </div>
        )}

        <div class="prose game-prose" data-highlight>
          <slot />
        </div>

        <div class="detail-nav">
          <PostNav prev={prevPost} next={nextPost} locale={locale} />
        </div>
      </main>
    </article>
    <Footer />
  </body>
</html>

<style>
  /* Full-bleed cover. It slides under the sticky header like the home hero,
     so the image starts at the very top of the window. */
  .detail-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: clamp(20rem, 62svh, 40rem);
    margin-top: calc(var(--header-h) * -1);
    overflow: hidden;
  }

  .detail-cover {
    position: absolute;
    inset: 0;
    background: var(--navy-900);
  }

  .detail-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* Contrast is guaranteed by the gradient, not by the screenshot: the band
     behind the title is almost solid background colour whatever the image
     shows, and it fades into the page so there is no hard edge. */
  .detail-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        var(--background) 0%,
        rgba(7, 11, 22, 0.92) 22%,
        rgba(7, 11, 22, 0.55) 55%,
        rgba(7, 11, 22, 0.25) 100%
      );
  }

  .detail-hero-text {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 62rem;
    padding: 0 1.25rem 2rem;
    text-align: center;
  }

  .detail-title {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
  }

  .detail-genre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0.6rem 0 0;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-light);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
  }

  .detail-main {
    width: 1280px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 0 0 3em;
  }

  .detail-sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 880px;
    margin: 0 auto 2.25rem;
    padding: 1.1rem 0 1.4rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .detail-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    margin: 0;
  }

  .detail-fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 5rem;
  }

  .detail-fact dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .detail-fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .detail-roles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .detail-roles-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .detail-roles ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-video {
    margin: 0 auto 2.5rem;
  }

  .prose {
    width: 100%;
    max-width: 870px;
    margin: auto;
    padding: 0.05em;
    color: var(--color-text-secondary);
  }

  .detail-nav {
    max-width: 870px;
    margin: 0 auto;
  }
</style>
